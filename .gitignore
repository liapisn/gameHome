# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase cli
supabase/.temp/

# generated 3D exports / renders
/exports/

# Unreal render project: only the .uproject and Config are source; everything else is generated
/unreal/GameHomeRender/*
!/unreal/GameHomeRender/GameHomeRender.uproject
!/unreal/GameHomeRender/Config/

# resized copies of fixture media (regenerated by build:tour)
/fixtures/*/.derived/
